<!-- Mutation++ mixture for TACOT B' computation.
     Species set from tacot-air_35 (NASA-9 = CEA thermodynamic database, 35 species).
     Three element compositions for bprime -bl / -py / -cp:
       air        : boundary-layer edge  O2:0.21, N2:0.79  (O:0.42, N:1.58)
       tacot_pyro : TACOT pyrolysis gas  CH4:0.5551, CO:0.2418, H2O:0.2031
                    → C:0.7969, H:2.6266, O:0.4449
       carbon     : condensed phase (graphite)  C:1
     Usage:
       bprime -T 300:100:4000 -P 101325 -b 0.5 \
              -m tacot_air_bprime -bl air -py tacot_pyro -cp carbon
-->
<mixture thermo_db="NASA-9" >

    <species>
       C H O N CH4 CN CO CO2 C2 C2H C2H2,acetylene C3 C4 C4H2,butadiyne C5 HCN
       H2 H2O N2 CH2OH CNN CNC CNCOCN C6H6 CH CH2 CH3 C2H4 C2H6 C3H3,1-propynl
       C3H3,2-propynl C6H5O,phenoxy C6H5OH,phenol O2 OH C(gr)
    </species>

    <element_compositions default="air">
        <!-- Edge gas: dry air, O2:0.21 N2:0.79 molar -->
        <composition name="air">O:0.42, N:1.58</composition>

        <!-- Pyrolysis gas: CH4:0.5551, CO:0.2418, H2O:0.2031 molar
             (C:0.206 H:0.679 O:0.115 elemental mass fracs — matches PATO tacot26) -->
        <composition name="tacot_pyro">C:0.7969, H:2.6266, O:0.4449</composition>

        <!-- Condensed ablation phase: pure carbon (graphite) -->
        <composition name="carbon">C:1.0</composition>
    </element_compositions>

</mixture>
